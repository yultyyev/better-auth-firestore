{
  "name": "better-auth-firestore",
  "version": "0.0.0-development",
  "private": false,
  "description": "Firestore adapter for Better Auth (Firebase Admin SDK)",
  "author": "Slava Yultyyev <yultyyev@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "firestore.indexes.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "test": "./tests/test.sh",
    "verify:pack": "./scripts/verify-pack.sh",
    "lint": "biome check --formatter-enabled=false",
    "lint:fix": "biome check --write",
    "lint:fix:unsafe": "biome check --write --unsafe",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yultyyev/better-auth-firestore.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "better-auth",
    "firebase",
    "firestore",
    "adapter",
    "authjs",
    "nextauth",
    "oauth",
    "session",
    "typescript"
  ],
  "peerDependencies": {
    "better-auth": "*",
    "firebase-admin": ">=13",
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "better-auth": "^1.7.1",
    "firebase-admin": "^13.10.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@tootallnate/once@<3.0.1": ">=3.0.1",
      "kysely@<=0.28.13": ">=0.28.14",
      "kysely@>=0.28.12 <=0.28.13": ">=0.28.14",
      "fast-xml-parser@<5.10.1": ">=5.10.1",
      "fast-xml-builder@<1.1.7": ">=1.1.7",
      "lodash@<=4.17.23": ">=4.18.0",
      "protobufjs@<7.5.5": ">=7.5.5",
      "vite@>=7.0.0 <=7.3.1": ">=7.3.2",
      "micromatch>picomatch": "^2.3.2",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "brace-expansion@<5.0.5": ">=5.0.5",
      "node-forge@<1.4.0": ">=1.4.0",
      "node-forge@<=1.3.3": ">=1.4.0",
      "@grpc/grpc-js@>=1.14.0 <1.14.4": ">=1.14.4",
      "form-data@<2.5.6": ">=2.5.6",
      "protobufjs@>=8.0.0 <=8.5.0": ">=8.6.0",
      "protobufjs@>=8.0.0 <=8.4.0": ">=8.4.1",
      "undici@<6.27.0": ">=6.27.0",
      "undici@>=7.0.0 <7.28.0": ">=7.28.0",
      "undici@>=7.23.0 <7.28.0": ">=7.28.0",
      "uuid@<11.1.1": ">=11.1.1",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "js-yaml@<4.2.0": ">=4.2.0"
    }
  }
}
